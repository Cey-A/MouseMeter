<!--
  MouseMeter.Sdk.csproj - the alternate compiler path.

  Build.ps1 uses CodeDOM, which only exists in Windows PowerShell 5.1. This project
  compiles the exact same src\*.cs into the exact same kind of artifact (a
  .NET Framework 4.8 WinExe) through the dotnet SDK, so it also works on Linux and
  macOS and in CI.

  Two things it deliberately does the same as Build.ps1:
    * LangVersion 5 - CodeDOM rejects C# 6+, so a green build here must mean green there.
    * AssemblyInfo.cs is compiled, not generated - the version numbers and the Chinese
      AssemblyDescription come from that file and nowhere else.

  The app icon is embedded twice, on purpose, for two different consumers:
    * <ApplicationIcon> stamps the Win32 icon Explorer and the taskbar read from the exe.
    * IconResource.cs carries the same bytes as a C# literal so GetType().Assembly has
      an icon to hand out without touching the resource section.
  gen-icon.ps1 regenerates IconResource.cs from MouseMeter.ico on every build; the file
  itself is an artifact and lives in obj\, not in source control.

  Build:   dotnet build pack\MouseMeter.Sdk.csproj -c Release
  Output:  pack\bin\Release\net48\MouseMeter.exe   (+ MouseMeter.exe.config)
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- AssemblyInfo.cs is the single source of truth; never let the SDK write a second one. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <!-- CodeDOM is C# 5 only. Pinning it here is what makes this check meaningful. -->
    <LangVersion>5</LangVersion>

    <AssemblyName>MouseMeter</AssemblyName>
    <RootNamespace>MouseMeter</RootNamespace>
    <ApplicationIcon>..\MouseMeter.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <NoWarn>CS0618;CS0169;CS0414;CS0649;CS1591</NoWarn>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\*.cs" />
    <!-- Generated by the target below, not by hand and not committed. -->
    <Compile Include="$(BaseIntermediateOutputPath)IconResource.cs" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!--
    Runs before CoreCompile so the file exists by the time the compiler enumerates Compile items.
    The generated file is rewritten on every build: it takes milliseconds, and a stale icon is
    worse than a slow build.

    Two hosts, because this project exists precisely to be buildable off Windows:
      * Windows  -> Windows PowerShell 5.1, which is always present.
      * elsewhere -> pwsh 7 if installed. If neither, fail with a readable message instead of
        MSB3073 on a missing executable.
  -->
  <PropertyGroup>
    <_IconHost Condition="'$(OS)' == 'Windows_NT'">powershell</_IconHost>
    <_IconHost Condition="'$(OS)' != 'Windows_NT' and '$(PwshPath)' != ''">$(PwshPath)</_IconHost>
    <_IconHost Condition="'$(OS)' != 'Windows_NT' and '$(PwshPath)' == ''">pwsh</_IconHost>
  </PropertyGroup>

  <!-- PwshPath is passed as a property, not probed: a build step that shells out to
       "which pwsh" behaves differently on every host, and the failure mode is a hang, not an error. -->
  <Target Name="GenerateIconLiteral" BeforeTargets="BeforeCompile;CoreCompile"
          Condition="'$(SkipIconGeneration)' != 'true'">
    <Exec Command="&quot;$(_IconHost)&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)gen-icon.ps1&quot; -Root &quot;$(MSBuildThisFileDirectory)..&quot;"
          IgnoreStandardErrorWarningFormat="true"
          IgnoreExitCode="false" />
  </Target>
</Project>
