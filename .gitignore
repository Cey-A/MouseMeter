# build output — the exe is produced by Build.ps1, never committed
/dist/

# the SDK path's intermediate output (pack\ holds the project, not its results)
/pack/bin/
/pack/obj/

# verify stamp: written by Verify.ps1, read by Sync-Docs.ps1.
# Not committed: it describes one machine's last run, and committing it would let a stale
# green number survive a change that broke the tests.
/.verify-last

# runtime / tool leftovers
*.log
*.tmp
/.vs/
/packages/
/obj/
/bin/

# local overrides a developer might keep around
/settings.json
